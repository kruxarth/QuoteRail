# PostgreSQL connection string. Use Neon's pooled URL in hosted environments.
DATABASE_URL=postgres://quoterail:quoterail@localhost:5432/quoterail
# Optional local Docker Postgres used by unit/integration/e2e tests.
LOCAL_DATABASE_URL=postgres://quoterail:quoterail@localhost:5432/quoterail

# Merchant-side OpenCode Go inference. Never expose this to MCP or the browser.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# Submission builds require this exact model.
SELLER_MODEL=gpt-5.6-luna

# Razorpay test-mode credentials. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Static demo buyer bearer token for the public MCP endpoint.
BUYER_MCP_TOKEN=replace-with-a-long-random-demo-token

# Merchant console password. Issue a signed session cookie on success.
MERCHANT_ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SIGNING_SECRET=replace-with-a-32-byte-random-secret

APP_BASE_URL=http://localhost:3000

# Show the demo-reset button only during controlled rehearsal.
DEMO_RESET_ENABLED=false

# Real Payment Link creation is opt-in. Tests always use the fake provider.
REAL_RAZORPAY_TESTS_ENABLED=false

# Force fake adapters even when keys are present. Tests set these automatically.
FAKE_AI=
FAKE_PAYMENTS=
